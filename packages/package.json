{
    "name": "graphty-staging",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Staging workspace for packages destined for the graphty monorepo (graph-format, graph-io, webgpu-graph-algorithms)",
    "scripts": {
        "build": "pnpm -r run build:all",
        "test": "pnpm -r run test",
        "test:run": "pnpm -r run test:run",
        "lint": "pnpm -r run lint",
        "lint:knip": "knip",
        "typecheck": "pnpm -r run typecheck",
        "coverage": "pnpm -r run coverage",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "engines": {
        "node": ">=18.19.0"
    },
    "packageManager": "pnpm@10.0.0",
    "devDependencies": {
        "@eslint/js": "^9.29.0",
        "@types/node": "^20.19.9",
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/ui": "^3.2.4",
        "eslint": "^9.29.0",
        "eslint-plugin-jsdoc": "^50.6.17",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "fast-check": "^4.2.0",
        "globals": "^15.12.0",
        "jiti": "2.4.2",
        "knip": "^5.61.3",
        "prettier": "^3.4.2",
        "tsx": "^4.20.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.34.1",
        "vite": "^7.0.0",
        "vitest": "^3.2.4"
    }
}
