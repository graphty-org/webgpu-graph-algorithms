{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "paths": {
            "@graphty/graph-format": ["./dist/graph-format.d.ts"]
        }
    },
    "include": ["test/types/**/*.test-d.ts"],
