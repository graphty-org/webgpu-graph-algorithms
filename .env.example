# Environment variables for WebGPU Graph Algorithms

# HTTPS Configuration (optional)
HTTPS_CERT_PATH=/path/to/server.crt
HTTPS_KEY_PATH=/path/to/server.key

# Server Configuration
HOST=my.server.com
PORT=9010

# Note: Server ports must be in range 9000-9099
# Currently used ports on server: 9025, 9091