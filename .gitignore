# Repository-root ignore list (contract 1.1). packages/ carries its own .gitignore for the pnpm workspace.
node_modules
dist
coverage
tmp/
.tmp/
*.tsbuildinfo
# Written with a leading **/ so the package's benchmarks/out/ is covered: a pattern with a slash in the
# middle is relative to the directory of this file and would match only <root>/benchmarks/out/.
**/benchmarks/out/
browser-results.json
gpu-report.json
*.log
# The review probe logs are committed on purpose (contract 1.1: docs/research/review/probes/*.log).
!packages/webgpu-graph-algorithms/docs/research/review/probes/*.log
.DS_Store
# The archive of past Claude Code sessions, synced by claude-history-sync.sh (see CLAUDE.md).
.claudehistory/
# Playwright MCP snapshots and console logs written next to the page under test.
.playwright-mcp/
